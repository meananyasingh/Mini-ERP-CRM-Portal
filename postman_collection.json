{
  "info": {
    "name": "Mini ERP + CRM Operations Portal",
    "_postman_id": "b7e2f6d0-1a2b-4c3d-9e5f-erpcrm00001",
    "description": "REST API collection for the Mini ERP + CRM Operations Portal case study. Import into Postman, set the `baseUrl` collection variable (default http://localhost:4000/api), then run 'Login as Admin' first — it auto-saves the token into {{token}} for every other request via its Tests script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "challanId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.test\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login as Sales",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"sales@erp.test\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "Login as Warehouse",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"warehouse@erp.test\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "Login as Accounts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"accounts@erp.test\",\n  \"password\": \"Password@123\"\n}" }
          }
        },
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Create user (admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Sales User\",\n  \"email\": \"new.sales@erp.test\",\n  \"password\": \"Password@123\",\n  \"role\": \"sales\"\n}"
            }
          }
        },
        {
          "name": "List users (admin only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/users"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers (search/filter/paginate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&search=&status=&customerType=",
              "host": ["{{baseUrl}}"], "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "" },
                { "key": "customerType", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get customer detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Traders\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"ramesh@traders.com\",\n  \"businessName\": \"Ramesh Traders Pvt Ltd\",\n  \"gstNumber\": \"27AAAAA0000A1Z5\",\n  \"customerType\": \"Wholesale\",\n  \"address\": \"123 MG Road, Pune\",\n  \"status\": \"Lead\",\n  \"notes\": \"Met at trade fair\"\n}"
            }
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Active\"\n}" }
          }
        },
        {
          "name": "List follow-ups for customer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/customers/{{customerId}}/followups"
          }
        },
        {
          "name": "Add follow-up note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/customers/{{customerId}}/followups",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called customer, interested in bulk order\",\n  \"followUpDate\": \"2026-08-20\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products (search/filter/paginate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=&category=&lowStock=false",
              "host": ["{{baseUrl}}"], "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "category", "value": "" },
                { "key": "lowStock", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Steel Pipe 2 inch\",\n  \"sku\": \"SP-2IN-001\",\n  \"category\": \"Pipes\",\n  \"unitPrice\": 450.00,\n  \"currentStock\": 200,\n  \"minStockAlert\": 20,\n  \"location\": \"Warehouse A\"\n}"
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"unitPrice\": 475.00\n}" }
          }
        },
        {
          "name": "List stock movements for product",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/products/{{productId}}/stock-movements?page=1&limit=10"
          }
        },
        {
          "name": "Stock adjust — IN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/products/{{productId}}/stock-adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 50,\n  \"movementType\": \"IN\",\n  \"reason\": \"New purchase order received\"\n}"
            }
          }
        },
        {
          "name": "Stock adjust — OUT (insufficient stock example)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/products/{{productId}}/stock-adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 999999,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Damaged stock write-off\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "List challans (filter/paginate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/challans?page=1&limit=10&status=&customerId="
          }
        },
        {
          "name": "Get challan detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/challans/{{challanId}}"
          }
        },
        {
          "name": "Create challan (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) {",
                  "  pm.collectionVariables.set('challanId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/challans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 5 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update challan items (Draft only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/challans/{{challanId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 8 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Confirm challan (reduces stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/challans/{{challanId}}/confirm"
          }
        },
        {
          "name": "Cancel challan (restocks if was Confirmed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/challans/{{challanId}}/cancel"
          }
        },
        {
          "name": "Download challan PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/challans/{{challanId}}/pdf"
          }
        }
      ]
    }
  ]
}
