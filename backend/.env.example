PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Set to "true" for hosted Postgres (Neon/Supabase/Render Postgres) which
# require SSL. Leave unset/false for a local docker-compose Postgres.
DB_SSL=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
